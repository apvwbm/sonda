# Puerto de escucha.
SONDA_PORT=8080

# Directorio único de datos. En Docker es /data; en desarrollo, ./data.
SONDA_DATA_DIR=./data

# Zona con la que se calcula local_date.
SONDA_TZ=Europe/Madrid

# Contraseña de la interfaz. Obligatoria: sin ella el servidor no arranca.
SONDA_PASSWORD=cambiame

# Firma de la cookie de sesión. Si se deja vacía se genera sola y se guarda
# en SONDA_DATA_DIR.
# SONDA_SESSION_SECRET=

# Listening port.
SONDA_PORT=8080

# Single data directory. /data in Docker, ./data in development.
SONDA_DATA_DIR=./data

# Time zone used to compute local_date.
SONDA_TZ=Europe/Madrid

# Web interface password. Required: without it the server refuses to start.
SONDA_PASSWORD=change-me

# Session cookie signing key. Left unset, one is generated and stored in
# SONDA_DATA_DIR so sessions survive a restart.
# SONDA_SESSION_SECRET=

# Demo instances only. Both accept 'true', 'false', '1' or '0', and both are
# false unless set. Read opens GET /api/series, /api/observations and
# /api/stats to anyone; write additionally opens POST /api/series and
# POST /api/observations. PATCH, DELETE and /api/export are never opened.
# Do not turn either on where the data is real.
# SONDA_PUBLIC_READ=false
# SONDA_PUBLIC_WRITE=false

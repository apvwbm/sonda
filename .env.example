# Listening port.
SONDA_PORT=8080

# Single data directory. /data in Docker, ./data in development.
SONDA_DATA_DIR=./data

# Time zone used to compute local_date.
SONDA_TZ=Europe/Madrid

# Web interface password. Required: without it the server refuses to start.
SONDA_PASSWORD=change-me

# Session cookie signing key. Left unset, one is generated and stored in
# SONDA_DATA_DIR so sessions survive a restart.
# SONDA_SESSION_SECRET=

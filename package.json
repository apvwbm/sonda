{
  "name": "sonda",
  "version": "0.1.0",
  "private": true,
  "description": "Almacén y API de datos personales, self-hosted",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "token": "node --env-file-if-exists=.env src/cli.ts token",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  }
}

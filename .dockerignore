# Everything the image does not need. The smaller the build context, the faster
# the build and the fewer layers invalidated for no reason.

# Installed inside, for the right platform: the laptop's node_modules carries a
# native binary for the wrong OS and would break the image.
**/node_modules

# Compiled inside.
dist

# Data and secrets never belong in an image.
data
.env
.env.*

.git
.gitignore
docs
test
tsconfig.test.json

# Host-side systemd units. They configure the machine, not the container.
deploy

# The seed stays out of the image: sowing fake data in production makes no
# sense, and it would drag src/ along with it.
scripts/seed.ts

*.md
Dockerfile
.dockerignore

# web/ sources are NOT ignored: the web stage builds them. Its output and cache
# are rebuilt inside, and a locally built web/dist would only be copied in to be
# thrown away. `dist` above only matches the top level, so these are explicit.
web/dist
web/.astro
